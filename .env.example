# Copy to .env (same folder as this file) and fill in. Never commit .env.
# Read automatically by `make up` / `astrq serve` and by Docker Compose.
# Priority: shell environment > .env > config/settings.yaml
# Any setting in settings.yaml can be overridden: ASTRQ_<SECTION>__<SUBSECTION>__<KEY>=value

# ---------------------------------------------------------------- Telegram alerts (optional)
# 1) Create a bot with @BotFather (/newbot) -> paste the token below.
# 2) Send any message to the bot (or add it to a group), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[].message.chat.id
#    (group ids are negative, e.g. -1001234567890).
ASTRQ_ALERTS__TELEGRAM__ENABLED=false
ASTRQ_ALERTS__TELEGRAM__BOT_TOKEN=
ASTRQ_ALERTS__TELEGRAM__CHAT_ID=
# Minimum severity sent to Telegram: info | notice | alert
ASTRQ_ALERTS__TELEGRAM__MIN_SEVERITY=alert
ASTRQ_ALERTS__TELEGRAM__MAX_PER_MINUTE=20

# ---------------------------------------------------------------- Data source
# synthetic (demo) | replay (recorded JSONL) | ssi (SSI FastConnect Data) | dnse (skeleton)
ASTRQ_PROVIDER__KIND=synthetic
# Synthetic market speed (simulated seconds per real second)
ASTRQ_PROVIDER__SYNTHETIC__SPEED=30
# Replay file and speed (used when ASTRQ_PROVIDER__KIND=replay)
# ASTRQ_PROVIDER__REPLAY__PATH=data/ticks/replay.jsonl
# ASTRQ_PROVIDER__REPLAY__SPEED=20

# ---------------------------------------------------------------- DNSE LightSpeed API
# Register online: developers.dnse.com.vn -> "Đăng ký" -> log in to EntradeX -> choose
# Smart OTP or Email OTP -> confirm. API Key + API Secret appear once on the success
# screen (later: EntradeX -> your name -> Thông tin tài khoản -> LightSpeed API).
# To switch from the demo to DNSE, set all of the block below (uncomment):
# ASTRQ_PROVIDER__KIND=dnse
# ASTRQ_PROVIDER__DNSE__API_KEY=
# ASTRQ_PROVIDER__DNSE__API_SECRET=
# ASTRQ_CONTEXT__KIND=recorded
# ASTRQ_SESSIONS__ENFORCE_TRADING_DAYS=true

# ---------------------------------------------------------------- SSI FastConnect Data
# (alternative; requires registering FastConnect API at an SSI counter / via your broker)
# Create the key pair on SSI iBoard (API service registration). The secret is shown once.
# To switch from the demo to SSI, set all of the block below (uncomment):
# ASTRQ_PROVIDER__KIND=ssi
# ASTRQ_PROVIDER__SSI__CONSUMER_ID=
# ASTRQ_PROVIDER__SSI__CONSUMER_SECRET=
# Real feed: baselines from our own recorded ticks; weekends/holidays are closed.
# ASTRQ_CONTEXT__KIND=recorded
# ASTRQ_SESSIONS__ENFORCE_TRADING_DAYS=true
# Optional: X = trades + best bid/ask (more traffic); subscribe_all = whole market
# ASTRQ_PROVIDER__SSI__CHANNEL=X-TRADE
# ASTRQ_PROVIDER__SSI__SUBSCRIBE_ALL=false

# ---------------------------------------------------------------- Server
ASTRQ_API__PORT=8000
# Use 0.0.0.0 only on a VPS behind a firewall/reverse proxy (the dashboard has no login).
ASTRQ_API__HOST=127.0.0.1
ASTRQ_LOG_LEVEL=INFO
